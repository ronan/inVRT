<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{it.project.name}} — InVRT Report</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bulma/1.0.4/css/bulma.min.css" integrity="sha512-yh2RE0wZCVZeysGiqTwDTO/dKelCbS9bP2L94UvOFtl/FKXcNAje3Y2oBg/ZMZ3LS1sicYk4dYVGtDex75fvvA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" integrity="sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma-switch@2.0.0/dist/css/bulma-switch.min.css">
    <script src="https://cdn.jsdelivr.net/npm/hyperscript.org@0.9.91/dist/_hyperscript.min.js" crossorigin="anonymous"></script>
    <style>
      .card {
        --bulma-card-content-padding: 5px;
      } 
      [data-theme=light],
      .theme-light {
        --bulma-scheme-main: #eee;
      }
      .box {
        --bulma-box-shadow: none;
      }
      .panel {
        --bulma-panel-shadow: none;
        --bulma-panel-item-border: 0;
      }
      .thumbnail {
        overflow-y: hidden;
        border-radius: 10px;
      }
      .thumbnail img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
      }
      details > summary:first-of-type {
        list-style-type: none;
      }
    </style>
  </head>

  <body>
    <header class="is-flex-direction-row container mt-5 mb-0 box">

      <div class="media">
        <figure class="image thumbnail is-128x128 media-left">
          <img src="approved/{{it.pages[0].id}}.png"/>
        </figure>
      
        <div class="media-content block is-flex-direction-column flex-grow">
          <div class="field is-pulled-right" id="dark-mode-switch">
            <i class="fas fa-sun"></i>
            <input type="checkbox" class="switch is-rounded is-small" name="dark-mode" checked="true">
            <label for class="dark-mode"><i class="fas fa-moon"></i></label>
          </div>

          <h1 class="title mb-1">{{it.project.title}}</h1>
          <div class="is-pulled-right has-text-right is-size-7">
            <div>
              Tested: 
              <time datetime="{{it.tested_at}}" data-relative-time> {{it.tested_at}}</time>
            </div>
            <div>
              Took: <span class="duration" data-duration="{{it.stats.duration}}">{{it.stats.duration}} ms</span>
            </div>
          </div>
          <div class="is-family-monospace is-size-7">
            url: <a href="{{it.project.url}}" target="_blank" rel="noreferrer" class="truncate hover:underline">
              {{it.project.url}}
            </a>
            <div class="">id: {{it.project.id}}</div>
          </div>
        </div>
      </div>
    </header>

    <section class="container">
      <nav class="panel">
        <div class="panel-block columns">
          <div class="column pl-0">
            <ul class="tabs is-justify-content-start is-toggle is-toggle-rounded">
              <li class="is-active"><a class="is-active">All</a></li>
              <li class=""><a style="">Changed <span class="tag is-danger ml-2 is-rounded">{{it.counts.failed}}</span></a></li>
              <li class=""><a class="">Approved <span class="tag is-success ml-2 is-rounded">{{it.counts.passed}}</span></a></li>
              <li class=""><a class="">Untested <span class="tag ml-2 is-rounded">{{it.counts.untested}}</span></a></li>
            </ul>
          </div>

          <div class="control has-icons-left is-h">
            <input class="input" type="text" placeholder="Filter by title, path or id"
              _="on input
                hide #no-match
                show <details/> in #pages
                when its textContent contains my value
                ignoring case
                show #no-match when the result is empty"
            />
            <span class="icon is-left">
              <i class="fas fa-search" aria-hidden="true"></i>
            </span>
          </div>

        </div>

        <div id="no-match" hidden>No pages matching the current filter.</div>
        <div id="pages">
          {{@each(it.pages) => page, index}}
            <details class="card is-primary is-align-items-flex-start is-clickable"
                _="on toggle
                  go to '#{{page.id}}-test' then
                  scroll to me
                "
              >
              <summary class="p-3 is-size-6">
                <div class="card-content">
                  <div class="media">
                    {{@if('files' in page && 'thumbnail' in page.files)}}
                      <div class="media-left">
                        <figure class="image thumbnail is-96x96">
                          <img src="{{page.files.thumbnail.path}}" alt="Screenshot of {{page.title}}" loading="lazy">
                        </figure>
                      </div>
                    {{/if}}

                    <div class="media-content">
                      <div class="is-size-7 has-text-right is-pulled-right">
                        {{@if('results' in page && 'duration' in page.results)}}
                          <div class="duration" data-duration="{{page.results.duration}}">{{page.results.duration}} ms</div>
                        {{/if}}
                        {{@if('results' in page && 'startTime' in page.results)}}
                          <time datetime="{{page.results.startTime}}" title="{{page.results.startTime}}" data-relative-time>
                            {{page.results.startTime}}
                          </time>
                        {{/if}}
                      </div>

                      <h2 class="">{{page.title}}</h2>
                      <div class="is-family-monospace">
                        <div class="is-size-7">path: {{page.path}}</div>
                        <div class="is-size-7">id: {{page.id}}</div>
                      </div>
                    </div>
                  </div>
                </div>
              </summary>

              {{@if('files' in page)}}
                <nav class="results panel pb-1" id="#{{page.id}}">
                  <div class="tabs panel-tabs is-centered is-toggle">
                    <ul>
                      {{@if('test' in page.files)}}
                        <li data-tab="{{page.id}}-test">
                        <a href="#{{page.id}}-test">Test</a></li>
                      {{/if}}

                      {{@if('reference' in page.files)}}
                        <li data-tab="{{page.id}}-reference">
                          <a href="#{{page.id}}-reference">Reference</a></li>
                      {{/if}}

                      {{@if('diff' in page.files)}}
                        <li data-tab="{{page.id}}-iff">
                          <a href="#{{page.id}}-diff">Difference</a></li>
                      {{/if}}

                      {{@if('test' in page.files && 'reference' in page.files)}}
                        <li data-tab="{{page.id}}-sidebyside"> 
                          <a href="#{{page.id}}-sidebyside">Side By Side</a>
                        </li>
                      {{/if}}

                    </ul>
                  </div>

                  {{@if('test' in page.files)}}
                    <div id="{{page.id}}-test" class="tab-content box">
                      <img src="{{page.files.test.path}}" alt="Test">
                    </div>
                  {{/if}}
                  {{@if('reference' in page.files)}}
                    <div id="{{page.id}}-reference" class="tab-content box">
                      <img src="{{page.files.reference.path}}" alt="Reference">
                    </div>
                  {{/if}}
                  {{@if('diff' in page.files)}}
                    <div id="{{page.id}}-diff" class="tab-content box">
                      <img src="{{page.files.diff.path}}" alt="Difference">
                    </div>
                  {{/if}}
                  {{@if('test' in page.files && 'reference' in page.files)}}
                    <div id="{{page.id}}-sidebyside" class="tab-content box">
                      <div class="columns box">
                        <figure class="column is-half">
                          <figcaption class="">Reference</figcaption>
                          <img src="{{page.files.reference.path}}" alt="Reference">
                        </figure>
                        <figure class="column is-half">
                          <figcaption class="">Test</figcaption>
                          <img src="{{page.files.test.path}}" alt="Test">
                        </figure>
                      </div>
                    </div>
                  {{/if}}
                {{/if}}
              </nav>

            </details>
          {{/each}}

        </div>
      </nav>
    </section>


    <footer class="container my-5 py-5 is-size-7">
      Generated at: 
      &nbsp;
      <time datetime="{{it.generated_at}}" data-local-time> {{it.generated_at}}</time>
      &nbsp;
      <span>by InVRT v.</span>
    </footer>

    <script>
      (function () {
        const toggleDarkMode = () => {
          const html = document.documentElement;
          const current = html.getAttribute('data-theme');
          html.setAttribute('data-theme', current === 'dark' ? 'light' : 'dark');
        };
        const activateDarkModeToggle = () => {
          var buttons = document.querySelectorAll("#dark-mode-switch");
          buttons.forEach(function (btn) {
            btn.addEventListener("click", function () {
              toggleDarkMode();
              btn.querySelectorAll('[type=checkbox]').forEach((checkbox) => {
                checkbox.checked = !checkbox.checked;
              });
            });
          });
        };
        activateDarkModeToggle();
      })();
    </script>
    <script>

      (function () {
        const units = [
          { ms: 86400000, u: 'day',    s: 'd' },
          { ms: 3600000,  u: 'hour',   s: 'h' },
          { ms: 60000,    u: 'minute', s: 'm' },
          { ms: 1000,     u: 'second', s: 's' }
        ];
        const relative = (() => {
          const rtf = new Intl.RelativeTimeFormat(navigator.language, { numeric: 'auto' });
          return ms => {
            const abs = Math.abs(ms);
            for (const { ms: step, u } of units)
              if (abs >= step) return rtf.format(Math.round(ms / step), u);
            return rtf.format(Math.round(ms / 1000), 'second');
          };
        })();
        const duration = ms => {
          if (ms < 0) ms = 0;
          let rest = ms;
          const parts = [];
          for (const { ms: step, s } of units) {
            const n = Math.floor(rest / step);
            if (n || parts.length) parts.push(`${n}${s}`);
            rest %= step;
            if (parts.length === 2) break;
          }
          return parts.length ? parts.join(' ') : '0s';
        };

        const hydrateDurations = () => {
          Array.prototype.forEach.call(document.querySelectorAll("[data-duration]"), function (el) {
            var dur = el.dataset.duration;
            el.title = dur + ' ms';
            el.textContent = duration(dur);
          });
        };
        const hydrateTimes = () => {
          Array.prototype.forEach.call(document.querySelectorAll("time[data-relative-time]"), function (el) {
          var date = new Date(el.dateTime);
          if (Number.isNaN(date.getTime())) return;
            el.textContent = relative(date - Date.now());
            el.title = "UTC: " + date.toUTCString() + "\nLocal: " + date.toLocaleString();
          });
        };
        hydrateTimes();
        hydrateDurations();

      })();
    </script>

    <script>
// activate the right tab on load or when the hash changes
function switchTab() {
  const target = location.hash.slice(1);      // "panel-1" etc.
  if (!target) return;

  // tabs
  document.querySelectorAll('.tabs li').forEach(li =>
    li.classList.toggle('is-active', li.dataset.tab === target)
  );
  // panels
  document.querySelectorAll('.tab-content').forEach(box =>
    box.classList.toggle('is-hidden', box.id !== target)
  );
}
window.addEventListener('hashchange', switchTab);
switchTab();
    </script>

  </body>
</html>

