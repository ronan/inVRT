---
import "@/styles/starwind.css";
import Header from "@/components/report/Header.astro";
import Footer from "@/components/report/Footer.astro";
import type { ReportData } from "@/lib/types";

interface Props {
  title: string;
  report: ReportData;
}

const { title, report } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      // Apply theme as early as possible to avoid flash.
      (function () {
        try {
          const colorTheme = localStorage.getItem("colorTheme");
          if (!colorTheme) {
            const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.classList.toggle("dark", prefersDark);
            localStorage.setItem("colorTheme", prefersDark ? "dark" : "light");
          } else {
            document.documentElement.classList.toggle("dark", colorTheme === "dark");
          }
        } catch (_) {
          /* ignore */
        }
      })();
    </script>
  </head>
  <body class="bg-background text-foreground min-h-screen flex flex-col">
    <div class="*:lg:px-10">
      <Header report={report} />
      <main class="flex-1 mx-auto px-4 py-6 w-full">
        <slot />
      </main>
      <Footer report={report} />
    </div>
  </body>
</html>
