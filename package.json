{
  "name": "invrt",
  "version": "0.4.4",
  "description": "An auth-enabled VRT for Drupal and Backdrop web sites and apps",
  "bin": {
    "invrt": "./bin/invrt"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build:runtime": "rm -rf dist/runtime && tsc -p tsconfig.runtime.json && node tooling/scripts/prepare-runtime-dist.mjs",
    "build:cli": "npm run build:runtime && rm -rf dist/cli && tsc -p tsconfig.build.json && node tooling/scripts/write-cli-package.mjs",
    "cli": "node ./dist/cli/cli.js",
    "typecheck": "tsc --noEmit",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronan/inVRT.git"
  },
  "keywords": [
    "vrt",
    "test",
    "automation"
  ],
  "author": "Ronan Dowling",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ronan/inVRT/issues"
  },
  "homepage": "https://github.com/ronan/inVRT#readme",
  "dependencies": {
    "@playwright/test": "^1.59.1",
    "@tabler/icons": "^3.41.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.0",
    "astro": "^6.1.9",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "conf": "^15.0.2",
    "execa": "^9.6.0",
    "js-yaml": "^4.1.1",
    "pino": "^10.3.1",
    "playwright": "^1.59.1",
    "pretty-bytes": "^7.1.0",
    "sharp": "^0.34.5",
    "squirrelly": "^9.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@release-it/bumper": "^7.0.5",
    "bats": "^1.13.0",
    "handlebars": "^4.7.9",
    "release-it": "^19.2.4",
    "typescript": "^5.9.3"
  }
}
