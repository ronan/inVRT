---
import ThemeToggle from "@/components/report/ThemeToggle.astro";
import AspectRatio from "@/components/starwind/aspect-ratio/AspectRatio.astro";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/starwind/card";
import { toRelativeUrl } from "@/lib/url";
import type { ReportData } from "@/lib/types";

interface Props {
  report: ReportData;
}

const { report } = Astro.props;
const { project, homeReference, stats } = report;
const homeReferenceUrl = toRelativeUrl(homeReference, Astro.url.pathname);

function formatDuration(durationMs: number | undefined): string {
  if (!durationMs || durationMs <= 0) return "n/a";
  const totalSeconds = Math.round(durationMs / 1000);
  const hours = Math.floor(totalSeconds / 3600);
  const minutes = Math.floor((totalSeconds % 3600) / 60);
  const seconds = totalSeconds % 60;
  if (hours > 0) return `${hours}h ${minutes}m ${seconds}s`;
  if (minutes > 0) return `${minutes}m ${seconds}s`;
  return `${seconds}s`;
}

const statCards = [
  { label: "Run time", value: formatDuration(stats.durationMs) },
  { label: "Pages", value: String(stats.totalPages) }
];
---

<header id="report-top" class="border-b border-border bg-card/95 backdrop-blur">
  <div class="mx-auto flex w-full flex-col gap-4 px-4 py-4">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start">
      {homeReference && (
        <div class="w-full max-w-48 shrink-0 overflow-hidden rounded-lg border border-border bg-muted">
          <AspectRatio ratio={4 / 3}>
            <img
              src={homeReferenceUrl}
              alt={`${project.title} home page reference`}
              class="h-full w-full object-cover object-top"
              loading="lazy"
            />
          </AspectRatio>
        </div>
      )}

      <div class="flex min-w-0 flex-1 flex-col gap-3">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div class="min-w-0">
            <h1 class="truncate text-2xl font-semibold">{project.title}</h1>
            <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-sm text-muted-foreground">
              <span class="font-mono">{project.id}</span>
              <a href={project.url} target="_blank" rel="noreferrer" class="truncate hover:underline">
                {project.url}
              </a>
              {stats.checkedAt && (
                <time datetime={stats.checkedAt} class="truncate" data-local-time>
                  {stats.checkedAt}
                </time>
              )}
              Generated: <time datetime={report.generatedAt} class="truncate" data-local-time>
                {report.generatedAt}
              </time>
            </div>
          </div>

          <ThemeToggle />
        </div>

        <div class="flex gap-2">
          {statCards.map((card) => (
            <Card size="xs" class="min-w-20 shrink-0">
              <CardHeader class="p-2 pb-0">
                <CardTitle class="text-xs uppercase tracking-wide text-muted-foreground">{card.label}</CardTitle>
              </CardHeader>
              <CardContent class="p-2 pt-0">
                <div class="text-sm font-semibold">{card.value}</div>
              </CardContent>
            </Card>
          ))}
        </div>

      </div>
    </div>
  </div>
</header>
