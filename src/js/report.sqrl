<!DOCTYPE html>
<html lang="en" data-theme="dark"> 
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{it.project.name}} — InVRT Report</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bulma/1.0.4/css/bulma.min.css" integrity="sha512-yh2RE0wZCVZeysGiqTwDTO/dKelCbS9bP2L94UvOFtl/FKXcNAje3Y2oBg/ZMZ3LS1sicYk4dYVGtDex75fvvA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" integrity="sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma-switch@2.0.0/dist/css/bulma-switch.min.css">
    <script src="https://cdn.jsdelivr.net/npm/hyperscript.org@0.9.91/dist/_hyperscript.min.js" crossorigin="anonymous"></script>
    <style>
      [data-theme=light],
      .theme-light {
        --bulma-scheme-main: #eee;
      }
      .box {
        --bulma-box-shadow: none;
      }
      .card {
        --bulma-card-content-padding: 2px;
      } 
      .panel {
        --bulma-panel-shadow: none;
        --bulma-panel-item-border: 0;
      }
      .thumbnail {
        overflow-y: hidden;
        border-radius: 10px;
      }
      .thumbnail img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
      }
      details summary {
        position: relative;
        margin-bottom: 0;
        border-start-end-radius: var(--bulma-card-radius);
        border-start-start-radius: var(--bulma-card-radius);
      }
      details summary .level {
        display: none;
      }
      details[open] summary .level {
        display: block;
        margin-top: 10px;
        margin-bottom: -30px;
        padding-top: 0;
        background-color: transparent;
        @container scroll-state(stuck: top) {
          margin-bottom: -20px;
          .tabs {
            font-size: 12px;
          }
        }
      }
      details .tabs.is-toggle li a {
        background-color: var(--bulma-content-blockquote-background-color);
      } 
      details > summary:first-of-type {
        list-style-type: none;
      }
      .content details > summary h2 {
        margin-top: 0;
        margin-bottom: 0;
      }
      .content h1:not(:first-child),
      .content h2:not(:first-child)
      {
        margin-bottom: 0;
        margin-top: 0;
      }
      .results {
        margin-top: 10px;
      }
      figcaption {
        text-align: center;
        font-size: 15px;
        text-transform: uppercase;
        font-weight: 500;
      }
      .is-sticky {
        position: sticky;
        top: 0;
        z-index: 10;
        container-type: scroll-state;
        .level {
        }
      }
    </style>
  </head>

  <body class="content">
    <header class="is-flex-direction-row container mt-5 mb-0 box">

      <div class="media">
        <figure class="image thumbnail is-128x128 media-left">
          <img src="approved/{{it.pages[0].id}}.png"/>
        </figure>
      
        <div class="media-content block is-flex-direction-column flex-grow">
          <div class="field is-pulled-right" id="dark-mode-switch" _="">
            <i class="fas fa-sun"></i>
            <input type="checkbox" class="switch is-rounded is-small" id="dark-mode" name="dark-mode" checked="true"
              _="on change
              if my checked set (closest <html/>)'s @data-theme to 'dark' exit end
              set  (closest <html/>)'s @data-theme to 'light'
              "
              >
            <label for="dark-mode" class="dark-mode"><i class="fas fa-moon"></i></label>

          </div>

          <h1 class="title mb-1 has-text-weight-normal is-size-4">{{it.project.title}}</h1>
          <div class="is-pulled-right has-text-right is-size-7">
            <div>
              Tested: 
              <time datetime="{{it.tested_at}}" data-relative-time> {{it.tested_at}}</time>
            </div>
            <div>
              Took: <span class="duration" data-duration="{{it.stats.duration}}">{{it.stats.duration}} ms</span>
            </div>
          </div>
          <div class="is-family-monospace is-size-7">
            url: <a href="{{it.project.url}}" target="_blank" rel="noreferrer" class="truncate hover:underline">
              {{it.project.url}}
            </a>
            <div class="">id: {{it.project.id}}</div>
          </div>
        </div>
      </div>
    </header>

    <section class="container">
      <nav class="panel">
        <div class="panel-block level">
          <div class="">
            <ul class="tabs is-justify-content-start is-toggle is-toggle-rounded" 
               _="on click
                  set tab to the closest <[role=tab]/> to the target
                  if no tab exit end
                  take @class='is-active' from <[role=tab]/> in me for tab
                  if no (tab's @data-status) exit end
                  show <details/> in #pages with hidden
                  when its @data-status is (tab's @data-status)
              ">
              <li role="tab" class="is-active" _="on click show <details/> in #pages with hidden">
                <a>All
                  <span class="tag ml-2 is-rounded">{{it.counts.total}}</span>
                </a></li>
              <li role="tab" data-status="failed" class="">
                <a>Changed <span class="tag is-warning ml-2 is-rounded">{{it.counts.failed}}</span></a>
              </li>
              <li role="tab" data-status="passed">
                <a class="">Approved <span class="tag is-success ml-2 is-rounded">{{it.counts.passed}}</span></a>
              </li>
              <li role="tab" data-status="untested">
                <a class="">Untested <span class="tag ml-2 is-rounded">{{it.counts.untested}}</span></a>
              </li>
            </ul>
          </div>

          <div class="control has-icons-left is-h">
            <input class="input" type="text" placeholder="Filter by title, path or id"
              _="on input
                show <details/> in #pages
                when its textContent contains my value
                ignoring case
              "/>
            <span class="icon is-left">
              <i class="fas fa-search" aria-hidden="true"></i>
            </span>
          </div>

          <div class="is-size-7 has-text-grey level-item">
            <span id="page-count" class="showing">-</span> / 
            <span class="total">{{it.counts.total}}</span>
          </div>

        </div>

        <div id="pages" 
            _="on mutation(attributes) put (<.card:not([hidden])/> in me).length into #page-count">
          {{@each(it.pages) => page, index}}
            <details 
                id="{{page.id}}"
                data-status="{{page.status}}"
                class="card is-primary is-align-items-flex-start is-clickable p-0 has-background-black-ter"
                _="on toggle
                  go to '#{{page.id}}-test' then
                  scroll to me
                  on mutation(hidden) exit
                ">
              <summary class="is-sticky p-3 is-size-6 has-background-black-ter">
                <div class="card-content">
                  <div class="media">
                    {{@if('files' in page && 'thumbnail' in page.files)}}
                      <div class="media-left">
                        <figure class="image thumbnail is-96x96">
                          <img src="{{page.files.thumbnail.path}}" alt="Screenshot of {{page.title}}" loading="lazy">
                        </figure>
                      </div>
                    {{/if}}

                    <div class="media-content">
                      <div class="block is-pulled-right">
                        {{@if(page.status == 'passed')}}
                          <span class="tag is-success is-rounded">approved</span>
                        {{#elif(page.status == 'failed')}}
                          <span class="tag is-warning is-rounded">changed</span>
                        {{#else}}
                          <span class="tag is-rounded">{{page.status}}</span>
                        {{/if}}
                        <div class="is-size-7 has-text-right mt-1">
                          {{@if('results' in page && 'duration' in page.results)}}
                            <div class="duration" data-duration="{{page.results.duration}}">{{page.results.duration}} ms</div>
                          {{/if}}
                          {{@if('results' in page && 'startTime' in page.results)}}
                            <time datetime="{{page.results.startTime}}" title="{{page.results.startTime}}" data-relative-time>
                              {{page.results.startTime}}
                            </time>
                          {{/if}}
                        </div>
                      </div>

                      <h2 class="has-text-weight-normal is-size-5">{{page.title}}</h2>
                      <div class="is-family-monospace">
                        <div class="is-size-7">path: {{page.path}}</div>
                        <div class="is-size-7">id: {{page.id}}</div>
                      </div>
                    </div>
                  </div>
                </div>

              {{@if('files' in page)}}
                <div class="level">
                  <div class="tabs panel-tabs is-centered is-toggle"
                  _="on click
                      set tab to the closest <[role=tab]/> to the target
                      if no tab exit end
                      take @class='is-active' from <[role=tab]/> in me for tab
                      add @class='is-hidden' to <[role=tabpanel]/> in closest <nav/>
                      when its @id is not (tab's @aria-controls)
                      halt
                      ">
                    <ul>
                      {{@if('test' in page.files)}}
                        <li role="tab" class="is-active" aria-controls="{{page.id}}-test">
                        <a href="#{{page.id}}-test">Test</a></li>
                      {{/if}}

                      {{@if('reference' in page.files)}}
                        <li role="tab" aria-controls="{{page.id}}-reference">
                          <a href="#{{page.id}}-reference">Reference</a></li>
                      {{/if}}

                      {{@if('diff' in page.files)}}
                        <li role="tab" aria-controls="{{page.id}}-diff">
                          <a href="#{{page.id}}-diff">Difference</a></li>
                      {{/if}}

                      {{@if('test' in page.files && 'reference' in page.files)}}
                        <li role="tab" aria-controls="{{page.id}}-sidebyside"> 
                          <a href="#{{page.id}}-sidebyside">Side By Side</a>
                        </li>
                      {{/if}}
 
                    </li>
                  </div>
                </div>
                </summary>


                <nav class="results container pb-1 has-background-black-ter" id="#{{page.id}}">
                  {{@if('test' in page.files)}}
                    <div id="{{page.id}}-test" role="tabpanel" class="tab-content">
                      <div class="box">
                      <img src="{{page.files.test.path}}" alt="Test">
                      </div>
                    </div>
                  {{/if}}
                  {{@if('reference' in page.files)}}
                    <div id="{{page.id}}-reference" role="tabpanel" class="tab-content box is-hidden">
                      <div class="box">
                      <img src="{{page.files.reference.path}}" alt="Reference">
                      </div>
                    </div>
                  {{/if}}
                  {{@if('diff' in page.files)}}
                    <div id="{{page.id}}-diff" role="tabpanel" class="tab-content box is-hidden">
                      <div class="box">
                      <img src="{{page.files.diff.path}}" alt="Difference">
                      </div>
                    </div>
                  {{/if}}
                  {{@if('test' in page.files && 'reference' in page.files)}}
                    <div id="{{page.id}}-sidebyside" role="tabpanel" class="">
                      <div class="box">
                      <div class="columns is-1">
                        <figure class="column is-half">
                          <figcaption class="">Test</figcaption>
                          <img src="{{page.files.test.path}}" alt="Test">
                        </figure>
                        <figure class="column is-half">
                          <figcaption class="">Reference</figcaption>
                          <img src="{{page.files.reference.path}}" alt="Reference">
                        </figure>
                      </div>
                      </div>
                    </div>
                  {{/if}}
                {{/if}}
              </nav>

            </details>
          {{/each}}

        </div>
      </nav>
    </section>

    <footer class="container my-5 py-5 is-size-7">
      Generated at: 
      &nbsp;
      <time datetime="{{it.generated_at}}" data-local-time> {{it.generated_at}}</time>
      &nbsp;
      <span>by InVRT v.</span>
    </footer>

    <script>
      (function () {
        const units = [
          { ms: 86400000, u: 'day',    s: 'd' },
          { ms: 3600000,  u: 'hour',   s: 'h' },
          { ms: 60000,    u: 'minute', s: 'm' },
          { ms: 1000,     u: 'second', s: 's' }
        ];
        const relative = (() => {
          const rtf = new Intl.RelativeTimeFormat(navigator.language, { numeric: 'auto' });
          return ms => {
            const abs = Math.abs(ms);
            for (const { ms: step, u } of units)
              if (abs >= step) return rtf.format(Math.round(ms / step), u);
            return rtf.format(Math.round(ms / 1000), 'second');
          };
        })();
        const duration = ms => {
          if (ms < 0) ms = 0;
          let rest = ms;
          const parts = [];
          for (const { ms: step, s } of units) {
            const n = Math.floor(rest / step);
            if (n || parts.length) parts.push(`${n}${s}`);
            rest %= step;
            if (parts.length === 2) break;
          }
          return parts.length ? parts.join(' ') : '0s';
        };

        const hydrateDurations = () => {
          Array.prototype.forEach.call(document.querySelectorAll("[data-duration]"), function (el) {
            var dur = el.dataset.duration;
            el.title = dur + ' ms';
            el.textContent = duration(dur);
          });
        };
        const hydrateTimes = () => {
          Array.prototype.forEach.call(document.querySelectorAll("time[data-relative-time]"), function (el) {
          var date = new Date(el.dateTime);
          if (Number.isNaN(date.getTime())) return;
            el.textContent = relative(date - Date.now());
            el.title = "UTC: " + date.toUTCString() + "\nLocal: " + date.toLocaleString();
          });
        };
        hydrateTimes();
        hydrateDurations();

      })();
    </script>
  </body>
</html>

