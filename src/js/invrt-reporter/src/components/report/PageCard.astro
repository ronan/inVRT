---
import AspectRatio from "@/components/starwind/aspect-ratio/AspectRatio.astro";
import Badge from "@/components/starwind/badge/Badge.astro";
import { statusLabel, statusVariant } from "@/lib/status";
import { toRelativeUrl } from "@/lib/url";
import type { PageRecord } from "@/lib/types";

interface Props {
  page: PageRecord;
  /** Link target. If omitted, defaults to `#page-<id>`. */
  href?: string;
  /** When true the card is rendered as the header of the detail view. */
  static?: boolean;
}

const { page, href, static: isStatic = false } = Astro.props;
const linkHref = href ?? `#page-${page.id}`;
const variant = statusVariant(page);
const label = statusLabel(page);
const rawThumb = page.testScreenshot ?? page.referenceScreenshot;
const thumb = toRelativeUrl(rawThumb, Astro.url.pathname);
const checkedAtIso = page.checkedAt;

function formatDuration(durationMs: number | undefined): string {
  if (!durationMs || durationMs <= 0) return "n/a";
  if (durationMs < 1000) return `${durationMs} ms`;
  return `${(durationMs / 1000).toFixed(durationMs >= 10_000 ? 0 : 1)} s`;
}
const ref = toRelativeUrl(page.referenceScreenshot, Astro.url.pathname);
const test = toRelativeUrl(page.testScreenshot, Astro.url.pathname);
const diff = toRelativeUrl(page.diffScreenshot, Astro.url.pathname);

---
<article
    class="page-card group overflow-hidden rounded-lg border border-border bg-card hover:bg-muted transition"
    data-page-id={page.id}
    data-status={page.status}
    data-title={page.title.toLowerCase()}
    data-path={page.path.toLowerCase()}
    data-search-id={page.id.toLowerCase()}
  >
  <a
    href={linkHref}
    aria-label={`View details for ${page.title}`}
    data-detail-open={page.id}
  >
    <div class="page-card__summary"> 
      <div class="page-card__media block bg-muted">
        <AspectRatio ratio={1}>
          {thumb ? (
            <img
            src={thumb}
            alt={`Screenshot of ${page.title}`}
            class="h-full w-full object-cover [object-position:center_top]"
            loading="lazy"
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center text-sm text-muted-foreground">
            No screenshot
          </div>
        )}
      </AspectRatio>
    </div>
    
    <div class="page-card__body flex flex-col gap-3 p-3">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="truncate text-sm font-medium">
            {page.title}
          </h3>
          <p class="page-card__path truncate text-xs text-muted-foreground">{page.path}</p>
          <p class="page-card__id truncate font-mono text-xs text-muted-foreground">id: {page.id}</p>
        </div>
        <div class="flex shrink-0 flex-wrap items-center justify-end gap-1.5">
          <Badge variant={variant} size="sm">{label}</Badge>
        </div>
      </div>
      
      <div class="page-card__meta mt-auto flex flex-wrap items-center justify-between gap-2 text-xs text-muted-foreground">
        <div class="page-card__profiles flex flex-wrap gap-1">
          {page.profiles.map((p) => (
            <span class="inline-flex items-center rounded bg-muted px-1.5 py-0.5 text-[10px] uppercase tracking-wide text-muted-foreground">
              {p}
            </span>
          ))}
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="page-card__duration">{formatDuration(page.durationMs)}</span>
          {checkedAtIso ? (
            <time datetime={checkedAtIso} data-relative-time title={checkedAtIso} class="shrink-0">
              {checkedAtIso}
            </time>
          ) : (
            <span class="shrink-0">never</span>
          )}
        </div>
      </div>
    </div>
    </div>
  </a>

    <section class="page-card__detail col-span-full" data-detail-panel data-detail-id={page.id} hidden>
      {page.errorMessage && (
        <div class="rounded-lg border border-border bg-muted/50 p-3">
          <div class="mb-2 text-sm font-medium text-foreground">Failure details</div>
          <pre class="overflow-auto whitespace-pre-wrap text-xs text-foreground/90">
            {page.errorMessage}
          </pre>
        </div>
      )}

      <div class="flex flex-col gap-3 rounded-lg border border-border bg-card p-3 col-span-full" data-detail-tabs>
        <div class="flex flex-wrap gap-1 border-b border-border pb-2" role="tablist">
          <button
            type="button"
            class="rounded px-3 py-1 text-sm data-[active=true]:bg-primary data-[active=true]:text-primary-foreground"
            data-tab="side-by-side"
            data-active="true"
            role="tab"
          >Side by side</button>
          <button
            type="button"
            class="rounded px-3 py-1 text-sm data-[active=true]:bg-primary data-[active=true]:text-primary-foreground"
            data-tab="reference"
            data-active="false"
            role="tab"
          >Reference</button>
          <button
            type="button"
            class="rounded px-3 py-1 text-sm data-[active=true]:bg-primary data-[active=true]:text-primary-foreground"
            data-tab="test"
            data-active="false"
            role="tab"
          >Test</button>
          {diff && (
            <button
              type="button"
              class="rounded px-3 py-1 text-sm data-[active=true]:bg-primary data-[active=true]:text-primary-foreground"
              data-tab="diff"
              data-active="false"
              role="tab"
            >Diff</button>
          )}
        </div>

        <div data-panel="side-by-side" class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <figure class="flex flex-col gap-1">
            <figcaption class="text-xs uppercase tracking-wide text-muted-foreground">Reference</figcaption>
            {ref ? (
              <img src={ref} alt="Reference" class="w-full rounded-md border border-border" />
            ) : (
              <div class="text-sm text-muted-foreground">No reference screenshot</div>
            )}
          </figure>
          <figure class="flex flex-col gap-1">
            <figcaption class="text-xs uppercase tracking-wide text-muted-foreground">Test</figcaption>
            {test ? (
              <img src={test} alt="Test" class="w-full rounded-md border border-border" />
            ) : (
              <div class="text-sm text-muted-foreground">No test screenshot</div>
            )}
          </figure>
        </div>

        <div data-panel="reference" hidden>
          {ref ? (
            <img src={ref} alt="Reference" class="w-full rounded-md border border-border" />
          ) : (
            <div class="text-sm text-muted-foreground">No reference screenshot</div>
          )}
        </div>

        <div data-panel="test" hidden>
          {test ? (
            <img src={test} alt="Test" class="w-full rounded-md border border-border" />
          ) : (
            <div class="text-sm text-muted-foreground">No test screenshot</div>
          )}
        </div>

        {diff && (
          <div data-panel="diff" hidden>
            <img src={diff} alt="Diff" class="w-full rounded-md border border-border" />
          </div>
        )}
      </div>
    </section>
</article>

<style>
  .page-card {
  }
  .page-card__summary {
    display: grid;
    grid-template-columns: max(var(--card-size), var(--card-floor, 100px)) minmax(0, 1fr);
    align-items: stretch;
  }
  .page-card__media {
    width: max(var(--card-size), var(--card-floor, 100px));
    min-width: max(var(--card-size), var(--card-floor, 100px));
    align-self: stretch;
  }

  a[data-detail-close] {
    display: none;
  }

</style>