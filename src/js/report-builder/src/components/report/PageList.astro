---
import PageCard from "@/components/report/PageCard.astro"
import type { PageRecord } from "@/lib/types";
import { statusFiltersAll } from "@/lib/status";
import Badge from "../starwind/badge";
import { ButtonGroup, ButtonGroupSeparator } from "../starwind/button-group";
import { Checkbox } from "@/components/starwind/checkbox";

import SizeIcon from "@tabler/icons/outline/photo.svg";


interface Props {
  pages: PageRecord[];
}

const { pages } = Astro.props;
---

<section class="page-list-root flex flex-col gap-4" data-page-list>
    <div class="flex flex-wrap items-center gap-3 p-0">
    <!--  -->
    <div class="flex items-center gap-1 rounded-sm border border-border p-1" role="group" data-view-toggle>
      <button
      type="button"
      class="rounded px-2 py-1 text-md data-[active=true]:bg-primary data-[active=true]:text-primary-foreground"
      data-view="list"
      data-active="true"
      >List</button>
      <button
      type="button"
      disabled
      class="rounded px-2 py-1 text-md data-[active=true]:bg-primary data-[active=true]:text-primary-foreground opacity-50 cursor-not-allowed"
      data-view="gallery"
      data-active="false"
      >Gallery</button>
    </div>

    <div class="flex items-center gap-2 text-sm bg-card rounded-sm p-2">
      <label for="size-slider" class="text-muted-foreground sr-only">Size</label>
      <SizeIcon class="size-4" color="muted" />
      <input
      id="size-slider"
      type="range"
      min="100"
      max="600"
      step="20"
      value="100"
      data-size-slider
      />
      <SizeIcon class="size-6" color="" />
    </div>
  </div>


  
  <div class="flex flex-wrap items-center gap-3 rounded-lg border border-border bg-card p-3">
    <input
      type="search"
      placeholder="Filter by title, path, or id..."
      class="min-w-48 flex-1 rounded-md border border-border bg-background px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40"
      data-filter-input
    />
    <div class="flex flex-wrap gap-2" data-status-filters>
        {statusFiltersAll(pages).map(({ value, label, variant, count }) => (
           <Badge 
           variant={count > 0 ? variant : "ghost"}
           size="sm"
           data-status-filter-badge
           class="cursor-pointer text-xs">
            <Checkbox
              variant={variant} 
              size="sm"
              value={value}
              checked={count > 0}
              disabled={!count}
              class="peer"
              data-status-filter
              label={`${label} (${count})`}
            />
          </Badge>
        ))}
    </div>
    <div class="ml-auto text-xs text-muted-foreground" data-count></div>
  </div>

  <div class="page-list grid gap-4" data-page-grid data-view="list" style="--card-size: 100px;">
    {pages.map((page) => <PageCard page={page} />)}
  </div>


    </div>
  </div>
</section>

<style>
  .page-card {
    display: grid;
    grid-template-columns: max(var(--card-size), var(--card-floor, 100px)) minmax(0, 1fr);
    align-items: stretch;
  }


  .page-list {
    grid-template-columns: 1fr;
  }


  .page-list .page-card {
    cursor: pointer
  }

  .page-list[data-view="gallery"] {
    grid-template-columns: repeat(auto-fill, minmax(var(--card-size), 1fr));
  }

  .page-list[data-view="gallery"] .page-card {
    position: relative;
    min-height: 100%;
    width: 100%;
    border: 2px solid red;
  }

  .page-list[data-view="gallery"] .page-card__media {
    height: 100%;
  }

  .page-list[data-view="gallery"] .page-card_summary {
    position: absolute;
    inset: 0;
    justify-content: flex-end;
    background: linear-gradient(to top, rgb(10 10 10 / 0.92), rgb(10 10 10 / 0.18) 55%, transparent);
    color: white;

  }
  .page-list[data-view="gallery"] .page-card__body {
    display: none;
  }

  .page-list[data-view="gallery"] .page-card__path,
  .page-list[data-view="gallery"] .page-card__id,
  .page-list[data-view="gallery"] .page-card__meta,
  .page-list[data-view="gallery"] .page-card__duration {
    color: rgb(255 255 255 / 0.82);
  }

  .page-list[data-view="gallery"] .page-card__path,
  .page-list[data-view="gallery"] .page-card__id,
  .page-list[data-view="gallery"] .page-card__meta {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      opacity 180ms ease,
      max-height 180ms ease;
  }

  .page-list[data-view="gallery"] .page-card:hover .page-card__path,
  .page-list[data-view="gallery"] .page-card:hover .page-card__id,
  .page-list[data-view="gallery"] .page-card:hover .page-card__meta,
  .page-list[data-view="gallery"] .page-card:focus-within .page-card__path,
  .page-list[data-view="gallery"] .page-card:focus-within .page-card__id,
  .page-list[data-view="gallery"] .page-card:focus-within .page-card__meta {
    max-height: 10rem;
    opacity: 1;
  }

  .page-list[data-view="gallery"] .page-card .starwind-badge {
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.14);
  }

  .page-card[hidden] {
    display: none !important;
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector("[data-page-list]");
    if (!root) return;

    var grid = root.querySelector("[data-page-grid]");
    var filterInput = root.querySelector("[data-filter-input]");
    var statusFilters = Array.prototype.slice.call(root.querySelectorAll("[data-status-filter]"));
    var sizeSlider = root.querySelector("[data-size-slider]");
    var viewButtons = Array.prototype.slice.call(root.querySelectorAll("[data-view-toggle] button"));
    var countEl = root.querySelector("[data-count]");
    var cards = Array.prototype.slice.call(grid.querySelectorAll(".page-card"));
    var detailPanels = Array.prototype.slice.call(root.querySelectorAll("[data-detail-panel]"));
    var closeButtons = Array.prototype.slice.call(root.querySelectorAll("[data-detail-close]"));
    var openers = Array.prototype.slice.call(root.querySelectorAll("[data-detail-open]"));

    function formatRelative(date) {
      var diffMs = date.getTime() - Date.now();
      var abs = Math.abs(diffMs);
      var minute = 60 * 1000;
      var hour = 60 * minute;
      var day = 24 * hour;
      var rtf = new Intl.RelativeTimeFormat(undefined, { numeric: "auto" });
      if (abs < minute) return rtf.format(Math.round(diffMs / 1000), "second");
      if (abs < hour) return rtf.format(Math.round(diffMs / minute), "minute");
      if (abs < day) return rtf.format(Math.round(diffMs / hour), "hour");
      return rtf.format(Math.round(diffMs / day), "day");
    }

    function hydrateTimes() {
      Array.prototype.forEach.call(document.querySelectorAll("time[data-relative-time]"), function (el) {
        var date = new Date(el.dateTime);
        if (Number.isNaN(date.getTime())) return;
        el.textContent = formatRelative(date);
        el.title = "UTC: " + date.toUTCString() + "\nLocal: " + date.toLocaleString();
      });

      Array.prototype.forEach.call(document.querySelectorAll("time[data-local-time]"), function (el) {
        var date = new Date(el.dateTime);
        if (Number.isNaN(date.getTime())) return;
        el.textContent = date.toLocaleString();
      });
    }

    function syncCardFloors() {
      cards.forEach(function (card) {
        var body = card.querySelector(".page-card__body");
        if (!body) return;
        card.style.setProperty("--card-floor", Math.max(100, Math.ceil(body.getBoundingClientRect().height)) + "px");
      });
    }

    function applyFilters() {
      var query = filterInput.value.trim().toLowerCase();
      var allowed = new Set(
        statusFilters.filter(function (input) {
          return input.checked;
        }).map(function (input) {
          return input.value;
        }),
      );
      var visible = 0;

      cards.forEach(function (card) {
        var title = card.dataset.title || "";
        var path = card.dataset.path || "";
        var id = card.dataset.searchId || "";
        var status = card.dataset.status || "";
        var matchesQuery = !query || title.includes(query) || path.includes(query) || id.includes(query);
        var matchesStatus = allowed.has(status);
        var show = matchesQuery && matchesStatus;
        card.hidden = !show;
        if (show) visible += 1;
      });

      countEl.textContent = visible + " / " + cards.length + " pages";
      syncCardFloors();
      applySize();
    }

    function applySize() {
      var min = Number(sizeSlider.min || 100);
      var max = Number(sizeSlider.max || 400);
      var size = Number(sizeSlider.value || min);
      var clamped = Math.max(min, Math.min(max, size));
      sizeSlider.value = String(clamped);
      grid.style.setProperty("--card-size", clamped + "px");
    }

    function applyView(view) {
      grid.dataset.view = view;
      viewButtons.forEach(function (button) {
        button.dataset.active = String(button.dataset.view === view);
          syncCardFloors();
          applySize();
      });
    }

    function activateTabs(scope) {
      Array.prototype.forEach.call(scope.querySelectorAll("[data-detail-tabs]"), function (tabsRoot) {
        var tabs = Array.prototype.slice.call(tabsRoot.querySelectorAll("[data-tab]"));
        var panels = Array.prototype.slice.call(tabsRoot.querySelectorAll("[data-panel]"));

        tabs.forEach(function (tab) {
          tab.addEventListener("click", function () {
            var target = tab.dataset.tab;
            tabs.forEach(function (item) {
              item.dataset.active = String(item.dataset.tab === target);
            });
            panels.forEach(function (panel) {
              panel.hidden = panel.dataset.panel !== target;
            });
          });
        });
      });
    }

    function panelForId(id) {
      return detailPanels.find(function (panel) {
        return panel.dataset.detailId === id;
      });
    }

    function closeDetail(updateHash) {
      detailPanels.forEach(function (panel) {
        panel.hidden = true;
      });

      if (updateHash !== false && /^#page-/.test(window.location.hash)) {
        history.replaceState(null, "", window.location.pathname + window.location.search + "#report-top");
      }
    }

    function openDetail(id, updateHash) {
      var panel = panelForId(id);

      detailPanels.forEach(function (item) {
        item.hidden = item !== panel;
      });

      if (updateHash !== false && window.location.hash !== "#page-" + id) {
        history.replaceState(null, "", window.location.pathname + window.location.search + "#page-" + id);
      }
      panel.parentElement.scrollIntoView(true);
    }

    function toggleDetail(id) {
      var panel = panelForId(id);
      if (!panel) return;
      var isHidden = panel.hidden;
      detailPanels.forEach(function (item) {
        item.hidden = true;
      });
      if (isHidden) {
        openDetail(id);
      }
      else {
        closeDetail();
      }
    }

    function syncFromHash() {
      var match = /^#page-(.+)$/.exec(window.location.hash);
      if (match) {
        openDetail(match[1], false);
      } else {
        closeDetail(false);
      }
    }

    filterInput.addEventListener("input", applyFilters);
    statusFilters.forEach(function (input) {
      if (input.disabled) return;
      input.addEventListener("change", applyFilters);
      input.closest('[data-status-filter-badge]').getElementsByTagName("label")[0].addEventListener("click", function(event) {
        event.preventDefault();
        input.checked = !input.checked;
        applyFilters();
      });
    });
    sizeSlider.addEventListener("input", applySize);
    viewButtons.forEach(function (button) {
      button.addEventListener("click", function () {
        applyView(button.dataset.view);
      });
    });
    openers.forEach(function (link) {
      link.addEventListener("click", function (event) {
        event.preventDefault();
        toggleDetail(link.dataset.detailOpen);
      });
    });
    closeButtons.forEach(function (button) {
      button.addEventListener("click", function (event) {
        event.preventDefault();
        closeDetail();
      });
    });

    window.addEventListener("hashchange", syncFromHash);
    window.addEventListener("resize", function () {
      syncCardFloors();
      applySize();
    });
    window.addEventListener("keydown", function (event) {
      if (event.key === "Escape") {
        closeDetail();
      }
    });

    activateTabs(root);
    hydrateTimes();
    syncCardFloors();
    applySize();
    applyView("list");
    applyFilters();
    syncFromHash();
  })();
</script>
