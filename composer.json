{
    "name": "invrt/php-cli",
    "description": "An auth-enabled VRT for Drupal and Backdrop web sites and apps (PHP version)",
    "version": "0.4.4",
    "type": "application",
    "license": "MIT",
    "authors": [
        {
            "name": "Ronan Dowling"
        }
    ],
    "require": {
        "php": "^8.3",
        "psr/log": "^3.0",
        "symfony/yaml": "^7",
        "symfony/console": "^7",
        "symfony/process": "^7",
        "symfony/filesystem": "^7",
        "symfony/dependency-injection": "^7",
        "sqids/sqids": "^0.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/cli/",
            "InVRT\\Core\\": "src/core/"
        }
    },
    "bin": [
        "src/cli/invrt.php"
    ],
    "config": {
        "allow-plugins": {}
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94"
    }
}
